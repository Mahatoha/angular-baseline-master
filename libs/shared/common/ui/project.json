{
    "name": "shared-common-ui",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/shared/common/ui/src",
    "prefix": "ga",
    "projectType": "library",
    "tags": ["scope:common", "scope:shared", "type:ui"],
    "targets": {
        "build": {
            "executor": "@nx/angular:ng-packagr-lite",
            "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
            "defaultConfiguration": "production",
            "options": {
                "project": "libs/shared/common/ui/ng-package.json",
                "tsConfig": "libs/shared/common/ui/tsconfig.lib.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "libs/shared/common/ui/tsconfig.lib.prod.json"
                },
                "development": {}
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "libs/shared/common/ui/jest.config.ts",
                "tsConfig": "libs/shared/common/ui/tsconfig.spec.json"
            }
        }
    }
}
