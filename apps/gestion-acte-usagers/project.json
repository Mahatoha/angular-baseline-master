{
    "name": "gestion-acte-usagers",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "gau",
    "sourceRoot": "apps/gestion-acte-usagers/src",
    "tags": ["scope:usagers"],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "production",
            "options": {
                "outputPath": "dist/apps/gestion-acte-usagers",
                "browser": "apps/gestion-acte-usagers/src/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "apps/gestion-acte-usagers/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/gestion-acte-usagers/public"
                    }
                ],
                "styles": ["apps/gestion-acte-usagers/src/styles.scss"]
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "src/environments/environment.ts",
                            "with": "src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            }
        },
        "serve": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "defaultConfiguration": "development",
            "configurations": {
                "production": {
                    "buildTarget": "gestion-acte-usagers:build:production"
                },
                "development": {
                    "buildTarget": "gestion-acte-usagers:build:development",
                    "port": 4200,
                    "host": "0.0.0.0"
                }
            }
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "gestion-acte-usagers:build"
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "apps/gestion-acte-usagers/jest.config.ts",
                "tsConfig": "apps/gestion-acte-usagers/tsconfig.spec.json"
            }
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "gestion-acte-usagers:build",
                "port": 4200,
                "staticFilePath": "dist/apps/gestion-acte-usagers/browser",
                "spa": true
            }
        }
    }
}
